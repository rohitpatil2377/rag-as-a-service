# =============================================================================
# RAG as a Service — 12-factor configuration TEMPLATE.
# Copy to `.env` for local dev: `cp .env.example .env`.
# NEVER commit a real `.env`. NO secrets live in code or in this template.
# In production, values are injected by the SecretsProvider (Vault/HSM adapter),
# not from a file — see libs/common/src/rag_common/secrets.py.
# =============================================================================

# --- App ---
RAG_ENV=dev                       # dev | staging | prod
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=true                 # structured JSON logs (false = pretty console for dev)
RAG_API_HOST=0.0.0.0
RAG_API_PORT=8000

# --- Sovereignty guard ---
# Hard constraint: no egress to foreign/managed AI or cloud endpoints.
# When true, the LLM/embedding gateways refuse any non-allowlisted host.
RAG_SOVEREIGN_ENFORCE=true
RAG_ALLOWED_EGRESS_HOSTS=localhost,tei,vllm,qdrant,opensearch,minio,postgres

# --- Auth (dev stub: static JWT / mock OIDC). Replace with Keycloak/OIDC in Phase-1. ---
RAG_AUTH_MODE=dev_jwt             # dev_jwt | oidc
RAG_DEV_JWT_SECRET=dev-only-insecure-secret-change-me-32b+   # dev-only HS256 (>=32B); prod uses OIDC JWKS
RAG_OIDC_ISSUER=
RAG_OIDC_JWKS_URL=

# --- Secrets provider ---
RAG_SECRETS_PROVIDER=env          # env | vault (vault = Phase-1 adapter)
# RAG_VAULT_ADDR=
# RAG_VAULT_ROLE=

# --- Vector store (Qdrant for Phase-0 dev; behind VectorStore Protocol) ---
RAG_VECTOR_BACKEND=qdrant
RAG_QDRANT_URL=http://qdrant:6333
# At-scale collection config (applied at collection creation; defaults = single-node,
# full-precision, today's behaviour). Turn quantization on past tens of millions of
# vectors — see docs/production-sizing.md + infra/compose/.env.prod.example.
RAG_QDRANT_QUANTIZATION=none      # none | scalar (int8) | binary
RAG_QDRANT_ON_DISK=false
RAG_QDRANT_SHARDS=1
RAG_QDRANT_REPLICATION=1

# --- Sparse / BM25 (OpenSearch) ---
RAG_SPARSE_BACKEND=opensearch
RAG_OPENSEARCH_URL=http://opensearch:9200

# --- Object store (MinIO, S3-compatible; WORM/Object-Lock in Phase-1) ---
RAG_OBJECT_BACKEND=minio
RAG_MINIO_ENDPOINT=minio:9000
RAG_MINIO_ACCESS_KEY=minioadmin
RAG_MINIO_SECRET_KEY=minioadmin
RAG_MINIO_SECURE=false

# --- Metadata / lineage / catalog (Postgres; OpenMetadata deferred to Phase-1) ---
RAG_POSTGRES_DSN=postgresql+psycopg://rag:rag@postgres:5432/rag

# --- Embeddings (self-hosted TEI; small OSS model for dev) ---
RAG_EMBED_BACKEND=tei             # tei | vllm
RAG_TEI_URL=http://tei:80
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBED_DIM=384
# Embedding a whole document is one call per batch; on the CPU tier a large document needs well
# over the old 30 s. Raise it if a re-index times out on your biggest documents.
RAG_EMBED_TIMEOUT_SECONDS=180

# --- LLM gateway (any OpenAI-compatible server: self-hosted OR sovereign MaaS) ---
# llamacpp = CPU dev tier (llama.cpp server); vllm = GPU; openai_compat = any managed
# OpenAI-compatible endpoint; extractive_dev = zero-model fallback (no real generation).
RAG_LLM_BACKEND=llamacpp          # openai_compat | llamacpp | vllm | extractive_dev
RAG_VLLM_URL=http://llama:8080/v1 # OpenAI-compatible base (llama.cpp:8080 or vllm:8000/v1)
RAG_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct   # label only; the llama.cpp GGUF actually loaded is the source of truth
# To use the AIOps platform Model-as-a-Service (sovereign, OpenAI-compatible), set:
#   RAG_LLM_BACKEND=openai_compat
#   RAG_VLLM_URL=https://models-dev.example.internal/openai/v1
#   RAG_LLM_MODEL=<deployed model, e.g. qwendeploy>
#   RAG_LLM_API_KEY=<secret>            # injected at runtime; NEVER commit
#   RAG_LLM_API_KEY_HEADER=apikey       # Acme MaaS carries the key in the 'apikey' header
# and add the host to RAG_ALLOWED_EGRESS_HOSTS (it is sovereign/India-hosted, so allowed).
RAG_LLM_API_KEY=
RAG_LLM_API_KEY_HEADER=apikey
# Per-request read timeout for a generation call. This is a ceiling on GENERATION TIME, so it
# bounds how large a max_tokens budget can actually finish: at ~38 output tokens/s, 4,000 tokens
# needs ~105 s and 6,000 needs ~158 s. A request that outlives it is lost entirely — in the
# map stage that means its section silently contributes nothing to the answer.
RAG_LLM_TIMEOUT_SECONDS=240
# Per-KB model attach (FR-E1 roles): a tenant connects generation/embedding/reranking
# models from the console Models page (e.g. AIOps Qwen 32B, bge-m3, bge-reranker at
# models.example.internal — add the host to RAG_ALLOWED_EGRESS_HOSTS). Nothing configured here.
# Applying an embedding switch re-embeds the KB (admin POST /embedder/apply); the flag
# below disables that apply path wholesale if an operator wants attach-only.
RAG_EMBEDDER_SWITCH_ENABLED=true
# Model endpoints behind a PRIVATE CA: mount the CA PEM into the api container and point
# this at it. Applies to the LLM/embedder/reranker clients only. There is deliberately no
# way to disable TLS verification.
RAG_MODEL_CA_BUNDLE=

# --- Chunking (FR-C1) — how a document is cut before embedding ---
# ONE default for every entry point. These used to be four different literals across four API
# endpoints, so how a document was chunked depended on which door it came through — and a
# re-index silently converted it. The strategy actually used is recorded on the document
# (index_chunk_strategy) and a re-index reproduces it unless a new one is asked for.
RAG_CHUNK_STRATEGY=clause         # clause | fixed
RAG_CHUNK_SIZE=900                # FIXED only: character window
RAG_CHUNK_OVERLAP=150             # FIXED only: must be < size
RAG_CHUNK_MAX_CHARS=700           # CLAUSE only: hard cap on chunk size
# CLAUSE overlap reuses RAG_CHUNK_OVERLAP, clamped to half the cap. Governance text puts
# the exception at the END of a paragraph, so a chunk with no carry can hold a rule while
# the carve-out that limits it sits in the next chunk. 0 disables it.

# --- Grounding (grounded-or-abstain hard gate; per-tenant override in catalog) ---
# Calibrated against RAG_RERANK_MODEL — see docs/calibration.md. A threshold is a claim about
# ONE model's score distribution, so re-run scripts/calibrate_abstain.py after any reranker
# change (the adapter refuses to serve a model other than the configured one for this reason).
RAG_ABSTAIN_THRESHOLD=0.15

# --- Faithfulness verification (FR-E4) — three-way routing ---
RAG_FAITHFULNESS_ENABLED=true
RAG_FAITHFULNESS_BACKEND=lexical  # lexical (deterministic/CI) | llm (LLM-as-judge)
RAG_FAITHFUL_THRESHOLD=0.7        # >= this -> GROUNDED
RAG_FLAG_THRESHOLD=0.4            # [flag, faithful) -> FLAGGED_FOR_REVIEW; < flag -> ABSTAINED
# Notation verbatim-grounding (Slice 4) — additive, default OFF (byte-identical when off). Extends
# the numeric check: flags unit mismatches (5 g vs 5 mg), sub/superscript formula differences
# (H₂SO₄ vs H₂SO₃) and invented chemical/SMILES notation. Per-KB adaptive via the
# `notation_grounding_enabled` threshold override (1.0/0.0).
RAG_NOTATION_GROUNDING_ENABLED=false

# --- Contextual Retrieval (FR-C2) — additive, new-ingest-only (ADR-0007) ---
RAG_CONTEXTUAL_RETRIEVAL_ENABLED=false   # prepend doc-context to chunks before embed/BM25
RAG_CONTEXTUAL_RETRIEVAL_BACKEND=metadata  # metadata (deterministic) | llm (per-chunk LLM)

# --- Adaptive query router (FR-D5) — additive, default OFF ---
RAG_ADAPTIVE_ROUTER_ENABLED=false        # route simple->standard, complex->heavy (deeper)
RAG_ROUTER_BACKEND=heuristic             # heuristic (deterministic) | llm

# --- Query transformation (FR-D6) — additive, default OFF ---
RAG_QUERY_TRANSFORM_ENABLED=false        # heavy path: sub-queries -> retrieve each -> merge/dedupe
RAG_QUERY_TRANSFORM_BACKEND=decompose    # decompose (deterministic) | hyde | rewrite

# --- Exact technical-token matching (Slice 2a) — additive, default OFF (byte-identical when off) ---
RAG_EXACT_TERM_MATCH_ENABLED=false       # BM25 also matches whole chemical formulas / SMILES / IDs
RAG_EXACT_TERM_BOOST=2.0                  # global boost; per-KB adaptive via exact_boost override

# --- Guardrails (FR-G1 prompt-injection · FR-G3 toxicity) — default ON ---
RAG_GUARDRAILS_ENABLED=true              # block injection (input) + toxicity (output) -> ABSTAINED
RAG_GUARDRAILS_BACKEND=heuristic         # heuristic (deterministic) | llm (NeMo/LlamaGuard later)

# --- Console UI toggles ---
# Show the KB "Integrations" tab (embeddable widget + chat bot). Backends stay available;
# this only controls whether the console surfaces the tab. Runtime-read (no rebuild).
RAG_UI_INTEGRATIONS_ENABLED=false

# --- Observability (OTel → collector → Prometheus/Grafana) ---
RAG_OTEL_ENABLED=true
RAG_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
RAG_OTEL_SERVICE_NAME=ragaas-api

# --- Quotas & rate limits (FR-H1) — noisy-neighbour isolation, per-org sliding minute ---
# Rate limits are per organisation; the document cap is per knowledge base. 0 disables one.
RAG_QUOTA_ENABLED=true
RAG_QUOTA_QUERIES_PER_MINUTE=60
RAG_QUOTA_INGESTS_PER_MINUTE=30
RAG_QUOTA_MAX_DOCUMENTS_PER_KB=1000
# Token metering (per 1,000 total tokens across generations; server-reported or estimated)
RAG_FINOPS_COST_PER_1K_TOKENS=0.10

# --- P2 agentic features (FR-E5 semantic cache, FR-F2 agentic retry) ---
# Code default is OFF; the dev stack enables both so they are exercised end-to-end.
# Semantic cache: near-identical repeat questions (same KB + same ACL visibility) answer
# instantly from a per-KB LRU of grounded answers; invalidated on any ingest/delete/reindex.
RAG_SEMANTIC_CACHE_ENABLED=true
RAG_SEMANTIC_CACHE_THRESHOLD=0.97
RAG_SEMANTIC_CACHE_MAX_ENTRIES=256
# Agentic retry (CRAG-lite): when the first retrieval would abstain, transform the query
# into sub-queries and retry once, keeping whichever retrieval is stronger. Audited.
RAG_AGENTIC_RETRY_ENABLED=true

# --- GraphRAG (FR-C6/D4, P2) — knowledge graph + local graph retrieval ---
# Default OFF (changes what's indexed). "heuristic" extraction is deterministic/CPU-free;
# "llm" uses the KB's own model for a richer typed graph.
RAG_GRAPHRAG_ENABLED=true
RAG_GRAPH_EXTRACT_BACKEND=heuristic
RAG_GRAPH_RETRIEVAL_HOPS=1

# --- RAG v2 ingest (upgrade plan) — master flag for the section-tree / doc-profile ingest path ---
# Default OFF; off means the ingest path is byte-identical to today. ON, the ingest ALSO stores the
# extraction engine's layout markup as a JSON overlay under the tenant's `layout/` object prefix and
# records it in `documents.minio_layout_key` (only the Chandra OCR path produces markup; every
# plain-text extractor writes nothing). The overlay is never chunked, embedded or indexed, and it is
# purged with the document's raw bytes. The empty, additive v2 catalog tables are created
# unconditionally regardless of this flag, so every tenant schema has one shape.
# Phase 5 also makes this flag decide CHUNKING: with it on, a document whose extractor produced
# markup is chunked from its parsed structure tree (body-chunk / table-row levels, each
# carrying its breadcrumb in the text sent to the embedder) instead of from the flat character
# stream. Flag off => chunking is byte-identical to the clause path. Turning it on changes the
# pipeline fingerprint, so an existing corpus reports as stale until it is re-indexed; a plain-text
# document is unaffected either way (no markup => no block stream => nothing to chunk structurally).
RAG_V2_INGEST=false
# Target size for layout-aware chunks, in CHARACTERS (the plan asks for 300-500 TOKENS; 1600 chars
# is ~310 tokens of English prose and ~370 of serialized table rows at this corpus's measured
# chars/token ratios). A real token count needs the embedder's tokenizer, which only the TEI adapter
# exposes — see `rag_core.layout_chunking` for the mapping and where it is imprecise. Per
# doc_type values need the Phase-3 document profile; it now exists, so the override map below can
# narrow this per document class.
RAG_LAYOUT_CHUNK_MAX_CHARS=1600
# Plan §3's "config map: doc_type -> chunk profile", as `doc_type=chars` pairs, e.g.
# "corrigendum=1200,contract=2400". EMPTY BY DEFAULT and shipped empty on purpose: nothing has
# measured what a corrigendum or a contract should be chunked at (the 1600 above was calibrated
# against a token budget, not a document class), so the mechanism carries no invented numbers and
# every document chunks at the value above until somebody measures one. A malformed or
# out-of-range pair is skipped, not fatal — this is read on the ingest path for every document.
RAG_LAYOUT_CHUNK_MAX_CHARS_BY_DOC_TYPE=
# The chunk cap above is CHARACTERS and a character cap cannot bound a TOKEN budget — the same 1600
# characters are ~310 tokens of English prose and ~1000 of Devanagari, and TEI truncates over-long
# input silently (HTTP 200, a normal-looking vector, no header), so content past the embedder's
# limit stays in the stored text and in BM25 but is invisible to dense search. The layout chunker
# therefore lowers its own cap using the DOCUMENT's measured chars-per-token ratio when the
# embedder reports a token limit: an English tender leaves 1600 binding, a Devanagari one does not.
# No knob — it is derived per document from a measurement the indexing service already pays for.
#
# Guards on the born-digital layout capture (Phase 2c). Above this page count NO overlay is
# captured and the document chunks from the flat text stream: the capture is a second pdfplumber
# pass per page plus a JSON object holding every line's bbox and font metrics, both linear in pages.
# Measured at 29 blocks/page on a tender-shaped fixture: +0-20% extraction time and 6.7 KiB/page, so
# 2000 pages is ~13 MiB and ~58k blocks. The default is far above any real tender deliberately — a
# 2000-page corrigendum is the document this feature is FOR.
RAG_LAYOUT_CAPTURE_MAX_PAGES=3000
# Hard ceiling on the stored overlay object, for the pathological page a page count cannot see
# (thousands of tiny text runs). Over it the object is refused, not truncated, and the reason is
# logged; the structure rows still land and `documents.minio_layout_key` stays NULL.
RAG_LAYOUT_OVERLAY_MAX_BYTES=33554432
#
# The Phase-3 document profile card: ONE model call per document on the v2 ingest path, prompted
# by `rag_core/prompts/doc_profile.md`. Read only when RAG_V2_INGEST is on; with it off
# no call is made and no card is stored. The call is FAIL-SAFE — a model outage, a timeout or an
# unusable reply costs the document its card and nothing else, and the document indexes exactly as
# it did before the card existed.
#
# How much of the document's opening the prompt is shown. The plan says "first ~2 pages"; that is
# taken literally via the page map and then bounded, because two pages is not a bounded quantity
# and this text shares the context window with the heading outline. It is ALSO the evidence window:
# a declared relation's quote is validated against exactly this text, so raising it widens what the
# model may legitimately cite.
RAG_DOC_PROFILE_HEAD_CHARS=12000
# How many section breadcrumbs the prompt lists. The plan asks for the full list; a 200-page tender
# has thousands, which would crowd out the document text. Truncated with the dropped count stated,
# never silently.
RAG_DOC_PROFILE_MAX_BREADCRUMBS=400
# Completion budget for the profile call. A 15-facet taxonomy with descriptions plus a few quoted
# relations runs ~900 tokens; the headroom is for the quotes, which are verbatim and can be long.
RAG_DOC_PROFILE_MAX_TOKENS=1400
#
# Phase-4 section enrichment: ONE model call per enrichable SECTION, prompted by
# `rag_core/prompts/section_enrich.md`, producing the section's summary, its facet labels,
# its extracted key-values, any amendment it declares, and its standalone propositions. The
# summary and the propositions also become retrievable chunks (`level='section'` and
# `level='proposition'`). Read only when RAG_V2_INGEST is on.
#
# ONE CALL PER SECTION is why this has its own switch rather than riding on RAG_V2_INGEST:
# Phase 3 costs a document one call, this costs it one per section, so a 200-section tender is a
# different order of spend and latency. Turn it off to keep v2 chunking, the structure tree and
# the profile card without the per-section spend. Each call is FAIL-SAFE on its own — a failure
# costs THAT section its summary and propositions, never the document its ingest.
RAG_SECTION_ENRICH_ENABLED=true
# A hard ceiling on calls per document, applied in document order after the floor below. A
# truncated document logs that it was truncated.
RAG_SECTION_ENRICH_MAX_SECTIONS=400
# Below this many characters of its OWN text, a section is not enriched: a container heading, a
# page title and a one-line cross-reference carry nothing a summary would not simply restate, and
# in a deep outline they are the majority of the nodes.
RAG_SECTION_ENRICH_MIN_CHARS=200
# A section longer than this is read in windows, each enriched separately and the results merged.
# It is ALSO the evidence window: every quote is validated against the window the model was shown,
# never the whole section.
RAG_SECTION_ENRICH_WINDOW_CHARS=12000
# How many windows one section may be split into. Past it the rest of the section is not read and
# the drop is logged — an appendix that is one 400-page "section" must not consume a document's
# whole budget.
RAG_SECTION_ENRICH_MAX_WINDOWS=4
# Concurrent enrichment calls per document ("parallel, batched"). Unbounded parallelism against a
# tenant's own endpoint is a self-inflicted denial of service, and on a CPU tier it is a queue
# with extra steps.
RAG_SECTION_ENRICH_CONCURRENCY=4
# Completion budget for one enrichment call. A 4-sentence summary, a few key-values and a
# half-dozen quoted propositions run ~700 tokens; the headroom is for the verbatim quotes.
RAG_SECTION_ENRICH_MAX_TOKENS=1200
#
# Phase-12 query log: one row per answered question in the KB's own `query_log` table, carrying
# the question, the answer, the documents it cited and the PER-STAGE latency. Phase 1 created the
# table and the DPDP erasure path for it was built before anything wrote it; this is the switch
# that starts writing it.
#
# PER-STAGE TIMINGS ARE ALWAYS EMITTED regardless of this flag, as a `query_stage_timing`
# structured log line carrying stage durations, the trace id and the status — no question text, so
# it is safe to ship to any collector. This flag controls the durable ROW, which does hold the
# question and the answer. Turn it on where the latency numbers are wanted (the plan's §0 targets
# are unmeasurable without them); erasure, document delete and retention all already reach the
# rows. NOT gated on RAG_V2_INGEST — it measures the query path, which v2 ingest does not
# change.
RAG_QUERY_LOG_ENABLED=false
# Bounds on the two free-text columns. A row is an operations record, not a transcript, and
# truncation is marked in the stored text rather than silent.
RAG_QUERY_LOG_MAX_QUERY_CHARS=2000
RAG_QUERY_LOG_MAX_ANSWER_CHARS=8000
#
# Phase-10 answer verification. Every claim in a grounded answer is checked against THE SPAN IT
# CITES — not against the union of everything retrieved, which is what the older numeric guard
# does and why it cannot see a mis-attribution. Three deterministic checks: values (figures,
# quantities with their unit, standards designations, dates), the enumeration check (a source
# reading "HBOM and SBOM" answered as "SBOM" drops half the requirement while every word of the
# answer is supported), and the claim split they need. The NLI half of the plan's Phase 10 already
# exists and is unchanged (RAG_FAITHFULNESS_BACKEND=nli).
#
# DEFAULT OFF because it EDITS THE ANSWER. Flag-off is byte-identical.
RAG_V2_VERIFY=false
# What happens to a claim that fails:
#   report   — record the verdict in query_log.verification and change nothing. Adopt a guard like
#              this by measuring it against a live corpus first.
#   footnote — append "Could not be verified from the cited sources:" naming the failing claims
#              (DEFAULT). The reader keeps what the model said AND learns which part does not
#              check out.
#   drop     — remove the failing claims and footnote them. Stronger, and riskier: a false
#              positive deletes real content.
# The answer's STATUS is never changed by verification, deliberately — a deterministic check
# routed into ABSTAIN would let one false positive withhold a correct answer.
RAG_V2_VERIFY_ACTION=footnote
#
# Phase-7 query router. ONE decision per question, read off the PROFILE CARDS of the in-scope
# documents rather than off the query's words alone: which of the plan's six intents this is
# (lookup / aggregate / compare / summarize / procedural / relational), which documents and which
# of their OWN facets it touches, the facet-specific sub-queries an aggregate needs, and whether
# the answer must take the amendment view. Mapped onto the query plan the pipeline already routes
# on, so a decision selects an EXISTING answer mechanism.
#
# DEFAULT OFF because it changes what retrieval does: a decision's doc_ids scope retrieval and its
# sub_queries drive decomposition. Flag-off is byte-identical.
#
# NOT the plan's RAG_V2_QUERY, which is a tri-state (off/shadow/on) governing the whole v2 query
# path and which the boolean-only platform flag store cannot hold. This is the router alone.
RAG_V2_ROUTER=false
# heuristic (default) = deterministic cue tables, no model call, and the only path whose intent
# accuracy can be asserted against a labelled gold set. llm = one short gateway call over the
# cards, falling back to the heuristic decision on any trouble.
RAG_V2_ROUTER_BACKEND=heuristic
# How many documents' cards the router is shown when the caller named none. A SAMPLE, not a
# ranking: the plan says "top docs by doc-level retrieval" and there is no doc-level retrieval to
# ask, because the `doc` chunk level has no producer.
RAG_V2_ROUTER_MAX_CARDS=20
# Completion budget for the router call. Small, because this runs before EVERY answer and a slow
# router is a worse router than a less accurate one.
RAG_V2_ROUTER_MAX_TOKENS=400

# --- RAG v2 Phase 8: retrieval strategies ---
# Each router intent gets its own recipe: which retrieval GRAIN the hybrid primitive is asked for
# (RetrievalQuery.levels), whether hits expand to their parent section, and - for the aggregate
# class - a SECTION PASS that reads every section of the in-scope documents out of the catalog
# and reranks them instead of searching for passages.
#
# DEFAULT OFF because it changes what retrieval returns. ALSO gated on RAG_V2_ROUTER: a
# strategy is chosen by an intent, and with no decision there is no intent to choose by.
RAG_V2_RETRIEVAL=false
# The absolute score floor for selecting a section, on the cross-encoder's [0,1] scale. The plan
# sets it low - "recall over precision" - because an over-selected section costs one map call in
# Phase 9 while an under-selected one costs a missing requirement.
RAG_V2_SECTION_THRESHOLD=0.15
# The SCALE-FREE companion, applied by OR: also select a section scoring within this fraction of
# the best-scoring one. It exists because the absolute threshold selected 0 of 78 sections on the
# real AEGCL corrigendum at EVERY value down to 0.001 - a cross-encoder score is absolute only
# for a fixed candidate SHAPE, and 0.15 was calibrated against a retrieved passage, not against a
# breadcrumb plus a one-line summary. The ratios still separated cleanly. See ADR-0026.
# 0.0 turns it off and leaves the plan's absolute threshold alone.
RAG_V2_SECTION_RELATIVE=0.1
# Caps the Phase-9 map fan-out. Sections past it are recorded and stated in the coverage line,
# never silently dropped.
RAG_V2_MAX_SECTIONS=40
# Caps the LATENCY of the selection itself - a different bound. Every probe scores every
# candidate, so a 500-section tender with 7 probes is 3,500 cross-encoder scorings before a word
# is generated. Cards past the cap are still considered; they are just not scored.
RAG_V2_MAX_SECTION_CANDIDATES=400

# --- RAG v2 Phase 9: generation by map then reduce ---
# One extraction call per SELECTED section (the map), then one call that writes the answer from
# the extracted items and nothing else (the reduce). It exists because 38 selected sections of an
# 80-page tender are far past any context window worth trusting, and a model given all of them at
# once does not fail loudly - it answers from the first few and the last few, and the requirement
# in the middle is simply absent from an answer that reads complete.
#
# DEFAULT OFF because it REPLACES the answer for an aggregate-class question. Also gated on
# RAG_V2_RETRIEVAL: without a section selection there is nothing to map over. It DECLINES
# whenever it cannot do better (no selection, no section text, no item survived its quote check,
# nothing citable) and the ordinary single-pass generation runs instead.
RAG_V2_GENERATE=false
# Concurrency for the map fan-out, against the KB's own endpoint. Same ceiling and reason as
# RAG_SECTION_ENRICH_CONCURRENCY, but higher by default because this is the latency path.
RAG_V2_MAP_CONCURRENCY=6
# Completion budget for one section's extraction. MEASURED: at 1200, 18 of 38 map calls over the
# real AEGCL corrigendum were cut off mid-object. A truncated reply is now salvaged to its last
# complete item, so this is no longer a cliff - but a dense section still wants the room.
RAG_V2_MAP_MAX_TOKENS=2400
# How much of a section ONE map call is shown; a longer section is split into windows.
RAG_V2_MAP_SECTION_CHARS=12000
# How many windows one section may cost. MEASURED: truncating instead of windowing was the single
# largest cause of a missed requirement on the real AEGCL corrigendum - a tender section puts its
# spec table first and its certification/BOM clauses LAST, so the truncated tail was exactly the
# part a compliance question needed. Still bounded, because this is the latency path; a section
# past the bound is counted in MapReport.sections_truncated.
RAG_V2_MAP_MAX_WINDOWS=3
# Completion budget for the reduce call - the whole answer, grouped by facet.
RAG_V2_REDUCE_MAX_TOKENS=4000
# The plan's map_cache, keyed by (section, query signature, model). Off makes every question
# re-extract, which is correct but costs one model call per selected section every time.
RAG_V2_MAP_CACHE_ENABLED=true

# --- RAG v2 Phase 12: the two upstream caches ---
# NEITHER IS AN ANSWER CACHE. RAG_SEMANTIC_CACHE_ENABLED caches answers and has to re-check the
# stored gate every time it serves one, because an answer is a judgement a threshold could have
# changed. These cache things that are deterministic for fixed inputs - a router decision is a
# function of the question's words and the cards in scope; a section's reranker score is a
# function of (probe, candidate text) - so a hit cannot serve what a config change should have
# stopped. Both are cleared by the per-KB version counter the semantic cache already bumps on any
# ingest, delete or reindex. In-process, so each replica has its own copy.
RAG_V2_ROUTER_CACHE_ENABLED=true
RAG_V2_ROUTER_CACHE_SIZE=512
# Worth more than the router cache: on the real AEGCL corrigendum the section pass is nine probes
# over seventy-two candidates, and EIGHT of the nine are the document's own facet names, identical
# for every question asked of it. Two differently-worded compliance questions over the same
# document share eight of their nine rerank calls.
RAG_V2_SCORE_CACHE_ENABLED=true
# Counted in section-scorings, not questions: 72 sections x 9 probes is 648 for one document.
RAG_V2_SCORE_CACHE_SIZE=20000

# --- v1.1 conversational RAG (FR-I1) — multi-turn chat over the same pipeline ---
# A follow-up turn is condensed into a standalone query before it enters the unchanged
# answer pipeline. "heuristic" is deterministic and free (right for the CPU dev tier);
# "llm" rewrites via the tenant's own gateway (better, but one extra model call per turn).
RAG_CONVERSATION_CONDENSE_BACKEND=heuristic
RAG_CONVERSATION_HISTORY_TURNS=6

# --- Per-page scanned/OCR routing (FR-B4) ---
# A PDF page with fewer real characters than this has no usable text layer and is sent to OCR.
# Decided PER PAGE: a born-digital PDF that is mostly diagrams keeps the text layer on the pages
# that have one, instead of the whole document being pushed through slower, lossier OCR. A page
# with no text AND no image is treated as blank, not scanned, and is never sent to OCR.
RAG_OCR_SCANNED_CHARS_PER_PAGE=20

# --- Reranking (FR-D2) — cross-encoder over the fused candidate pool ---
# The reranker decides FINAL order and the confidence the abstain gate reads, so it runs in
# EVERY environment (it is no longer selected by the environment name). The only other value is
# "lexical", which scores by term overlap with no model — a max_score on a different scale from a
# cross-encoder threshold, so it is not a drop-in. There is no "none": with nothing writing a
# score, every query in the KB would abstain.
RAG_RERANK_BACKEND=cross_encoder
RAG_RERANK_URL=http://reranker:80
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Candidates the cross-encoder scores. Latency is linear in this: measured on a 16-core CPU at
# ~900-char chunks, ~105 ms/candidate for MiniLM-L-6 (22M) and ~510 ms for bge-reranker-base
# (278M). Raise it only with the GPU reranker.
RAG_RERANK_CANDIDATES=50
RAG_RERANK_TOP_K=20
RAG_RERANK_BATCH_SIZE=32
RAG_RERANK_TIMEOUT_SECONDS=30
