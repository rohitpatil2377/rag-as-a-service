# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- uv ---
# NOTE: uv.lock IS committed (reproducible sovereign builds). Do not ignore it.

# --- tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- secrets & local config (12-factor: never commit real config) ---
.env
.env.*
!.env.example
!.env.prod.example
*.pem
*.key
*.p12
secrets/

# --- local model weights / dev data (pulled from sovereign mirrors, not committed) ---
models/
*.gguf
*.safetensors

# --- store volumes / local runtime state ---
.data/
volumes/
*.db

# --- editor / OS ---
.vscode/
.idea/
.DS_Store
/backups/
# Activated compose overlays. Each ships as a `.example.yml` that IS tracked; the copy you
# activate is box-specific (endpoints, secrets, resource limits) and must stay out of git.
infra/compose/docker-compose.override.yml
infra/compose/docker-compose.deploy.yml
infra/compose/docker-compose.mesh.yml
infra/compose/docker-compose.local.yml

# Internal secrets doc — never commit
SECRETS.md

# env-specific helm values carry real secrets — keep local, never commit
infra/helm/values-*.yaml
!infra/helm/values-*.example.yaml
# packaged subchart build artifact (rebuild via: helm dependency build)
infra/helm/charts/*.tgz
# QA-program runtime outputs (regenerated by the gate/evidence scripts — never commit the snapshot)
infra/observability/textfile/*.prom
/compliance_evidence.json
/compliance_evidence.md
/ragas_report.json
/ragas_report.md
dist/

# Local agent-tooling state (oh-my-claudecode): session transcripts, HUD caches, checkpoints,
# notepads, handoffs. Per-developer scratch, and `hud-stdin-cache.json` records a session id and
# absolute transcript paths — none of it belongs in a repo that gets bundled for a customer.
# Two of these files were committed by accident in afa7df0 and are untracked by the same commit
# that added this rule; they stay on disk because they are live state.
# `.omc/skills/` is the documented exception: project-scoped skills ARE meant to be committed,
# so it is excluded from the ignore rather than being un-ignorable later.
# `**/.omc/*` rather than `/.omc/*`: the tool leaves state in NESTED `.omc` directories too
# (apps/console/, docs/rag_v2/, infra/compose/ all have one), and a root-anchored rule would have
# left those for the next `git add -A` to pick up — which is how one of them nearly landed in the
# Phase 6 commit. Matching the CONTENTS rather than the directory keeps the negation below
# reachable, since git does not descend into an ignored directory.
**/.omc/*
!/.omc/skills/
