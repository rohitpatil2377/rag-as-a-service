# Air-gap bundle manifest — single source of what gets packaged.
# Sourced by scripts/airgap-bundle.sh and scripts/airgap-install.sh.
#
# Images are derived from the compose file itself (`docker compose config --images`), so
# they never drift. This file only pins the things compose can't tell us:
#   - which named volumes hold MODEL WEIGHTS (bundle these, warmed once on a connected box),
#     vs DATA volumes (qdrant/opensearch/minio/pg) which must start EMPTY on the target.

# The compose file the bundle is built from.
COMPOSE_FILE="infra/compose/docker-compose.dev.yml"

# The project name pins container/volume prefixes deterministically on both machines.
COMPOSE_PROJECT_NAME="ragaas-airgap"

# Model-cache volumes to warm + export (CPU default profile). These hold the OSS model
# weights the self-hosted inference servers download on first run:
#   tei-cache       -> BAAI/bge-small-en-v1.5           (embeddings, TEI)
#   reranker-cache  -> cross-encoder/ms-marco-MiniLM-L-6-v2 (reranker, TEI)
#   nli-cache       -> MoritzLaurer/mDeBERTa-v3-...-xnli  (NLI faithfulness, TEI)
#   llama-cache     -> Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M (generation, llama.cpp)
MODEL_VOLUMES="tei-cache reranker-cache nli-cache llama-cache"

# Optional multimodal add-on (only if you deploy the vision service):
#   tei-vision-cache -> nomic-ai/nomic-embed-vision-v1.5
OPTIONAL_MODEL_VOLUMES="tei-vision-cache"

# Human-readable record of the model ids inside those volumes (documentation only; the
# actual bytes come from the warmed volumes, so there is no runtime huggingface.co pull).
MODEL_IDS="BAAI/bge-small-en-v1.5 cross-encoder/ms-marco-MiniLM-L-6-v2 MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7 Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M"
