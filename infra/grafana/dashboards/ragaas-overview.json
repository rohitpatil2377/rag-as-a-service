{
  "__comment": "RAG as a Service observability overview (FR-H5). Colours follow the Acme Brand book §20 data-viz palette (fixed series order Saffron→Emerald→Navy→Teal→Gold→Solar); Teal reserved for AI/predicted series only.",
  "title": "RAG as a Service — Platform Overview",
  "uid": "ragaas-overview",
  "tags": ["ragaas", "acme"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (http_route) (rate(http_server_duration_count[5m]))", "legendFormat": "{{http_route}}" }],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "A" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#E87722" } }] }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P95 query latency (target ≤ 3s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_bucket[5m])))", "legendFormat": "p95" }],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 }, "color": { "mode": "fixed", "fixedColor": "#0F7B3E" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "#0F7B3E", "value": null }, { "color": "#E87722", "value": 3000 }] } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Abstain rate (grounded-or-abstain gate)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(rag_abstain_total[15m])) / clamp_min(sum(rate(rag_query_total[15m])), 1)", "legendFormat": "abstain rate" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "fixed", "fixedColor": "#1A2B4A" } } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "AI: predicted vs actual load",
      "description": "AI/predicted series uses Quantum Teal per brand rule.",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rag_ai_predicted_load", "legendFormat": "AI predicted" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "#0EA5E9" }, "custom": { "lineWidth": 2, "lineStyle": { "fill": "dash" } } } }
    }
  ]
}
