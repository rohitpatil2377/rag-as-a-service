# Real-store CI env — point tooling at the ISOLATED disposable stack (docker-compose.ci.yml).
#
#   docker compose -f infra/compose/docker-compose.ci.yml up -d      # start (remapped ports)
#   source infra/compose/ci.env
#   uv run alembic -c libs/clients/alembic.ini upgrade head          # apply migrations
#   uv run pytest tests/integration tests/e2e -p no:cacheprovider    # real-store pass
#   docker compose -f infra/compose/docker-compose.ci.yml down -v    # tear down
#
# The ragaas-ci stack uses remapped host ports so it never collides with a shared dev stack.
export RAG_TEST_REAL_STORES=true
export RAG_INMEMORY=false
export RAG_ENV=dev
export RAG_OTEL_ENABLED=false
export RAG_QDRANT_URL=http://localhost:16333
export RAG_OPENSEARCH_URL=http://localhost:19200
export RAG_MINIO_ENDPOINT=localhost:19000
export RAG_MINIO_ACCESS_KEY=minioadmin
export RAG_MINIO_SECRET_KEY=minioadmin
export RAG_MINIO_SECURE=false
export RAG_POSTGRES_DSN=postgresql+psycopg://rag:rag@localhost:15432/rag
export RAG_TEI_URL=http://localhost:18080
export RAG_RERANK_URL=http://localhost:18083
export RAG_RERANK_BACKEND=cross_encoder
export RAG_NLI_URL=http://localhost:18085
