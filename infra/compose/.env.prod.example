# =============================================================================
# RAG as a Service — PRODUCTION deployment hardening overlay (VAPT response).
# Usage:  cp infra/compose/.env.prod.example infra/compose/.env   (then edit secrets)
#         docker compose -f infra/compose/docker-compose.dev.yml up -d
# This file closes the network/config findings from the Acme WebScanner VAPT report.
# =============================================================================

# --- (VAPT #3) Bind ALL internal infra ports to localhost only ----------------
# Postgres 5432, OpenSearch 9200, MinIO 9000/9001, TEI 8080, llama 8081,
# Prometheus 9090, Grafana 3000, OTel 4317 and the API 8000 become reachable
# ONLY from the host (use an SSH tunnel for admin) — NOT from the network.
# The public console stays on :80 (put TLS in front of it — see below).
RAG_INFRA_BIND=127.0.0.1

# --- (VAPT #7) Disable the dev token minter + require real auth ---------------
# With RAG_ENV=prod the unauthenticated /v1/dev/token endpoint returns 404.
# Set auth_mode=oidc to require SSO/MFA (see docs; console still ships dev-JWT UI).
RAG_ENV=prod
# RAG_AUTH_MODE=oidc

# --- (VAPT #1/#2) Security headers are ON by default; tune if needed ----------
# RAG_SECURITY_HEADERS_ENABLED=true
# RAG_HSTS_MAX_AGE=31536000

# --- Secrets — DO NOT use the dev defaults in production ----------------------
# Rotate every credential below; inject via your SecretsProvider/Vault, not here.
# POSTGRES_PASSWORD=<strong-random>
# MINIO_ROOT_PASSWORD=<strong-random>
# GF_SECURITY_ADMIN_PASSWORD=<strong-random>
# RAG_MASTER_KEY=<32+ byte base64 — envelope-encryption KEK>

# --- (VAPT #4) TLS ------------------------------------------------------------
# Terminate TLS at your ingress/reverse proxy in front of the console container
# (nginx/Traefik/Caddy + Let's Encrypt or an internal CA). Redirect 80 -> 443.
# Only TLS 1.2/1.3, AEAD ciphers. HSTS is already emitted by the app + nginx.

# =============================================================================
# PRODUCTION MODELS · EMBEDDINGS · SCALE (sovereign, self-hosted).
# Dev defaults are CPU-small; this is the recommended production profile.
# Bring up the GPU tier: `docker compose --profile gpu up -d` (serves tei-gpu + vllm).
# Read docs/production-sizing.md before loading data at scale.
#
# ⚠ RE-INDEX WARNING: changing the embedder (dim 384 -> 1024) invalidates every
#   existing vector. Choose the embedder BEFORE ingesting at scale.
# =============================================================================

# --- Embeddings — the retrieval-quality ceiling. BGE-M3: MIT, 1024-dim, MULTILINGUAL
#     (incl. Hindi/Indic). Served by the GPU TEI tier (tei-gpu, gpu profile). ----------
RAG_EMBED_BACKEND=tei
RAG_TEI_URL=http://tei-gpu:80
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_EMBED_DIM=1024
# Raise bulk-ingest concurrency on a GPU embedder (dev default 2; max 32):
# RAG_BULK_INGEST_CONCURRENCY=16

# --- Generation LLM — Qwen2.5-7B-Instruct (Apache-2.0) on vLLM/GPU (vllm, gpu profile).
#     Scale to 14B/32B with headroom; attach an Indic model (Sarvam) per-KB for Indic answers.
RAG_LLM_BACKEND=vllm
RAG_VLLM_URL=http://vllm:8000/v1
RAG_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Quality: use the stronger LLM judge in prod (the small judge over-flags) ----------
RAG_FAITHFULNESS_ENABLED=true
RAG_FAITHFULNESS_BACKEND=llm
RAG_GUARDRAILS_ENABLED=true

# --- Multi-replica scale/HA: point at internal Redis (shared rate-limit, cache
#     invalidation, single-leader eval/sync ticks). Internal store — not egress-guarded.
# RAG_REDIS_URL=redis://<redis-host>:6379/0

# --- Vector store at scale (Qdrant): applied at collection creation. Beyond a few tens of
#     millions of vectors, RAM is the binding constraint — turn quantization on. Existing
#     collections keep their config until re-indexed. See docs/production-sizing.md.
RAG_QDRANT_URL=http://qdrant:6333
RAG_QDRANT_QUANTIZATION=scalar    # none | scalar (int8, ~4x smaller) | binary (~32x, rescored)
RAG_QDRANT_ON_DISK=true           # full-precision vectors on disk, quantized in RAM
RAG_QDRANT_SHARDS=2               # >= number of cluster nodes
RAG_QDRANT_REPLICATION=2          # >= 2 for HA
# Egress allowlist for the GPU services (keep sovereignty enforced):
RAG_ALLOWED_EGRESS_HOSTS=tei-gpu,vllm,qdrant,opensearch,minio,postgres
